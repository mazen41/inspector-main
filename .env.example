# ==============================================
# Car Inspector Dashboard Environment Variables
# ==============================================

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000
VITE_API_SECURE=false

# Application Configuration
VITE_APP_NAME="Car Inspector Dashboard"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Dashboard for car inspectors to manage inspections and payments"

# Development Server Configuration
VITE_PORT=3000
VITE_HOST=true
VITE_PREVIEW_PORT=4173

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG=true
VITE_SHOW_DEV_TOOLS=true

# Authentication Configuration
VITE_JWT_STORAGE_KEY=car_inspector_token
VITE_JWT_REFRESH_THRESHOLD=300000
VITE_SESSION_TIMEOUT=3600000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_OFFLINE_MODE=false

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_RTL=false

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
VITE_UPLOAD_CHUNK_SIZE=1048576

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_ENABLE_SERVICE_WORKER=false

# Error Handling
VITE_ERROR_BOUNDARY_ENABLED=true
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=info

# Performance Configuration
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_PREFETCH_ROUTES=true

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_SECURE_COOKIES=false

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=
VITE_HOTJAR_ID=

# Third-party Services (Optional)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
VITE_WEBSOCKET_URL=

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here