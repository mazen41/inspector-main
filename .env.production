# ==============================================
# Car Inspector Dashboard - Production Environment
# ==============================================

# API Configuration
VITE_API_BASE_URL=https://samh.store/api
VITE_API_VERSION=v2
VITE_API_TIMEOUT=30000
VITE_API_SECURE=true
VITE_BACKEND_SYSTEM_KEY="8a/VbzZ5Yg6JYaJ8EBZgicvcuqBHPk7P8/v+XburEE8="

# Application Configuration
VITE_APP_NAME="Car Inspector Dashboard"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Dashboard for car inspectors to manage inspections and payments"

# Production Configuration
VITE_DEV_MODE=false
VITE_DEBUG=false
VITE_SHOW_DEV_TOOLS=false

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Authentication Configuration
VITE_JWT_STORAGE_KEY=car_inspector_token
VITE_JWT_REFRESH_THRESHOLD=300000
VITE_SESSION_TIMEOUT=3600000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_OFFLINE_MODE=true

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_DEFAULT_LANGUAGE=ar
VITE_ENABLE_RTL=false

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
VITE_UPLOAD_CHUNK_SIZE=1048576

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_ENABLE_SERVICE_WORKER=true

# Error Handling
VITE_ERROR_BOUNDARY_ENABLED=true
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=error

# Performance Configuration
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_CODE_SPLITTING=true
VITE_PREFETCH_ROUTES=true

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ALLOWED_HOSTS=samh.com,www.samh.com
VITE_SECURE_COOKIES=true

# Analytics (Configure with actual values)
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=
VITE_HOTJAR_ID=

# Third-party Services (Configure with actual values)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=
VITE_WEBSOCKET_URL=wss://ws.samh.com
